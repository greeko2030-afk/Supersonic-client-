<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Hero: version, PLAY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_supersonic_card"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SS.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/supersonic_home_hero_title" />

                <TextView
                    style="@style/SS.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/supersonic_tagline" />
            </LinearLayout>

            <ImageView
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_supersonic_logo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:drawableEnd="@drawable/spinner_arrow"
                app:drawableEndPadding="@dimen/_1sdp"
                app:drawableEndSize="@dimen/padding_heavy"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="@dimen/_30sdp" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:contentDescription="@string/supersonic_instances"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_edit_profile" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_perf_chip"
            style="@style/SS.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/supersonic_accent_light" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_play_arrow"
            android:drawablePadding="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/main_play"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Live stats (all values are measured on this phone) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_supersonic_card"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical">

            <TextView
                style="@style/SS.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/supersonic_home_ram_usage" />

            <TextView
                android:id="@+id/home_stat_ram_value"
                style="@style/SS.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <ProgressBar
                android:id="@+id/home_stat_ram_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="10dp"
                android:max="100"
                android:progressBackgroundTint="#16264D"
                android:progressTint="@color/supersonic_accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SS.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/supersonic_home_game_ram" />

            <TextView
                android:id="@+id/home_stat_game_ram_value"
                style="@style/SS.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/supersonic_accent_light" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:orientation="vertical">

            <TextView
                style="@style/SS.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/supersonic_home_ping" />

            <TextView
                android:id="@+id/home_stat_ping_value"
                style="@style/SS.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/supersonic_accent_light" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick optimization: real one-tap installs from Modrinth -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_supersonic_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bolt"
                android:tint="@color/supersonic_accent_light" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SS.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/supersonic_home_quick_opt" />

                <TextView
                    android:id="@+id/home_quick_opt_status"
                    style="@style/SS.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/supersonic_home_quick_opt_desc" />
            </LinearLayout>

            <Button
                android:id="@+id/home_quick_opt_manage"
                style="@style/SS.ButtonOutline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/supersonic_home_manage" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_quick_opt_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Featured modpacks (live from Modrinth) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_supersonic_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_modpacks"
                android:tint="@color/supersonic_accent_light" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SS.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/supersonic_home_modpacks" />

                <TextView
                    style="@style/SS.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/supersonic_home_modpacks_desc" />
            </LinearLayout>

            <Button
                android:id="@+id/home_modpacks_browse"
                style="@style/SS.ButtonOutline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/supersonic_home_browse_all" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_modpacks_status"
            style="@style/SS.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_modpack_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Agent -->
    <LinearLayout
        android:id="@+id/home_agent_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_supersonic_card_ripple"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bolt"
            android:tint="@color/supersonic_accent_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SS.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/supersonic_home_agent_title" />

            <TextView
                style="@style/SS.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/supersonic_home_agent_desc" />
        </LinearLayout>

        <Button
            android:id="@+id/home_agent_scan"
            style="@style/SS.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/supersonic_home_scan_fix" />
    </LinearLayout>

    <TextView
        style="@style/SS.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="@string/supersonic_home_library" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/home_lib_instances"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_supersonic_card_ripple"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_instances"
                android:tint="@color/supersonic_accent_light" />

            <TextView
                style="@style/SS.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/supersonic_instances"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_lib_resource_packs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_supersonic_card_ripple"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_image_pack"
                android:tint="@color/supersonic_accent_light" />

            <TextView
                style="@style/SS.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/supersonic_resource_packs"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_lib_worlds"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_supersonic_card_ripple"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_world"
                android:tint="@color/supersonic_accent_light" />

            <TextView
                style="@style/SS.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/supersonic_worlds"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SS.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="@string/supersonic_home_tools" />

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/custom_control_button"
        style="@style/LauncherMenuButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_supersonic_card_ripple"
        android:drawableStart="@drawable/ic_menu_custom_controls"
        android:text="@string/mcl_option_customcontrol" />

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/install_jar_button"
        style="@style/LauncherMenuButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_supersonic_card_ripple"
        android:drawableStart="@drawable/ic_menu_install_jar"
        android:text="@string/main_install_jar_file" />

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/share_logs_button"
        style="@style/LauncherMenuButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_supersonic_card_ripple"
        android:drawableStart="@android:drawable/ic_menu_share"
        android:text="@string/main_share_logs" />

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/open_files_button"
        style="@style/LauncherMenuButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_supersonic_card_ripple"
        android:drawableStart="@drawable/ic_folder"
        android:text="@string/mcl_button_open_directory" />
</LinearLayout>
